    m_Metadata:
      m_Items: []
  - m_Id: 478936215515162
    m_Localized: "\xC9chec de la r\xE9compense. Consultez la console."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515163
    m_Localized: "R\xE9compense annul\xE9e. Aucune r\xE9compense attribu\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515164
