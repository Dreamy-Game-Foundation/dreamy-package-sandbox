      m_Items:
      - rid: 2503060853407351273
  - m_Id: 478936215515155
    m_Localized: "\uC900\uBE44 \uC644\uB8CC | \uC2E4\uD589 \uD69F\uC218: {launch}
      | \uC2DC\uC791 \uCF54\uC778: {coins}"
    m_Metadata:
      m_Items:
      - rid: 2503060853407351273
  - m_Id: 478936215515156
    m_Localized: "\uC810\uC218 \uAC31\uC2E0: {value}"
    m_Metadata:
      m_Items:
      - rid: 2503060853407351273
  - m_Id: 478936215515157
    m_Localized: "\uC800\uC7A5 \uC644\uB8CC | \uCF54\uC778: {value}"
    m_Metadata:
      m_Items:
      - rid: 2503060853407351273
  - m_Id: 478936215515158
    m_Localized: "\uC124\uC815 \uB85C\uB4DC \uC644\uB8CC | \uCF54\uC778: {value}"
    m_Metadata:
      m_Items:
      - rid: 2503060853407351273
  - m_Id: 478936215515159
    m_Localized: "\uC5F0\uACB0 \uC11C\uBE44\uC2A4\uAC00 \uC900\uBE44\uB418\uC9C0
      \uC54A\uC544 \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515160
    m_Localized: "\uC628\uB77C\uC778 \uBCF4\uC0C1: \uC5F0\uACB0 \uD655\uC778 \uC911\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515161
    m_Localized: "\uC628\uB77C\uC778 \uBCF4\uC0C1 \uD68D\uB4DD: +10\uC810 (\uB370\uBAA8)"
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515162
    m_Localized: "\uBCF4\uC0C1 \uD68D\uB4DD \uC2E4\uD328. \uCF58\uC194\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515163
    m_Localized: "\uBCF4\uC0C1 \uD68D\uB4DD\uC774 \uCDE8\uC18C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC9C0\uAE09\uB41C \uBCF4\uC0C1\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515164
    m_Localized: "\uC5F0\uACB0 \uC7AC\uC2DC\uB3C4 \uD69F\uC218\uB97C \uCD08\uACFC\uD588\uC2B5\uB2C8\uB2E4.
      \uC9C0\uAE09\uB41C \uBCF4\uC0C1\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515165
    m_Localized: "\uACB0\uACFC\uB97C \uC54C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC7AC\uC2DC\uB3C4
      \uC804\uC5D0 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515166
    m_Localized: "\uB2E4\uB978 \uC791\uC5C5\uC774 \uC9C4\uD589 \uC911\uC785\uB2C8\uB2E4.
      \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
