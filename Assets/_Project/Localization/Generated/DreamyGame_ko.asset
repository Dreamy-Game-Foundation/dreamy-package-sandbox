  - m_Id: 478936215515151
    m_Localized: "\uC628\uB77C\uC778 \uBCF4\uC0C1 (+10\uC810)"
    m_Metadata:
      m_Items: []
  - m_Id: 478936215515152
    m_Localized: "\uCD08\uAE30\uD654 \uB300\uAE30 \uC911\u2026"
